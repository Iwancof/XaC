      "source_lines": [
        "// XaC Rust template sketch.",
        "// Compile target: wasm32-unknown-unknown with XaC host imports.",
        "",
        "#[no_mangle]",
        "pub extern \"C\" fn tick() {",
        "    if output_blocked() != 0 {",
        "        return;",
        "    }",
        "    mine();",
        "}",
        "",
        "extern \"C\" {",
        "    fn output_blocked() -> i32;",
        "    fn mine() -> i32;",
        "}"
      ]
    },
