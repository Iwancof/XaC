package xac:mvp;

/// Current behavior ABI draft for XaC's core Wasm runtime.
///
/// The engine currently links raw core Wasm imports such as
/// `xac:drill/mine` and `xac:router/push_item_dir`. This WIT file records the
/// same host API surface in SDK-friendly names. SDK bindings should lower
/// these names to the raw import modules and integer codes used by
/// `crates/xac-wasm`.
interface types {
  enum direction {
    north,
    east,
    south,
    west,
  }

  enum item-kind {
    ore,
    plate,
    ammo,
    cpu-part,
    drone-part,
  }

  enum enemy-kind {
    grunt,
    runner,
    armored,
    wire-cutter,
  }

  enum dropoff-tag {
    frontline,
  }
}

interface common-api {
  use types.{item-kind};

  /// Writes a short behavior log message. Raw core ABI: xac:common/log(ptr,len).
  log: func(message: string) -> bool;
  fuel-remaining: func() -> u64;
  inventory-count: func(item: item-kind) -> s32;
  inventory-free: func() -> s32;
  stock-count: func(item: item-kind) -> s32;
  stock-capacity: func(item: item-kind) -> s32;
  has-space: func(item: item-kind, amount: s32) -> bool;
}

interface net-api {
  store-get-i32: func(key: s32) -> s32;
  store-set-i32: func(key: s32, value: s32) -> bool;
  store-delete-i32: func(key: s32) -> bool;
}

interface drill-api {
  use types.{item-kind};

  output-blocked: func() -> bool;
  mine: func() -> bool;
  output: func(item: item-kind) -> bool;
  /// Returns an item-kind code in the raw ABI, or -1 when no ore exists.
  ore-kind: func() -> s32;
}

interface router-api {
  use types.{direction, item-kind};

  push-any: func() -> bool;
  push-dir: func(dir: direction) -> bool;
  push-item-dir: func(item: item-kind, dir: direction) -> bool;
  output-available: func(dir: direction) -> bool;
  output-item-available: func(item: item-kind, dir: direction) -> bool;
}

interface assembler-api {
  use types.{item-kind};

  set-recipe: func(recipe: item-kind) -> bool;
  /// Returns an item-kind code in the raw ABI, or -1 when no recipe is set.
  current-recipe: func() -> s32;
  can-produce: func() -> bool;
  input-count: func(item: item-kind) -> s32;
  output-count: func(item: item-kind) -> s32;
  produce: func() -> bool;
}

interface turret-api {
  /// Returns the number of visible enemies in the scan window.
  scan-enemies: func() -> s32;
  /// Returns an enemy-kind code in the raw ABI, or -1 for an invalid index.
  enemy-kind: func(index: s32) -> s32;
  enemy-hp: func(index: s32) -> s32;
  enemy-distance: func(index: s32) -> f32;
  can-attack: func(index: s32) -> bool;
  attack: func(index: s32) -> bool;
  ammo-count: func() -> s32;
  attack-nearest: func() -> bool;
  /// Policy is the packed priority code produced by XaC Script/Tiny.
  attack-best: func(policy: s32) -> bool;
}

interface drone-port-api {
  use types.{dropoff-tag, item-kind};

  dispatch: func() -> bool;
  stock-count: func(item: item-kind) -> s32;
  charge-docked-drones: func() -> bool;
  docked-drone-count: func() -> s32;
  pending-job-count: func() -> s32;
  create-delivery-job: func(item: item-kind, amount: s32, dropoff: dropoff-tag)
    -> bool;
  dispatch-idle-drones: func() -> bool;
}

interface drone-api {
  use types.{item-kind};

  battery-percent: func() -> s32;
  battery-ratio: func() -> f32;
  logic-fuel-remaining: func() -> u64;
  has-job: func() -> bool;
  has-pending-job: func() -> bool;
  return-to-port: func() -> bool;
  claim-delivery-job: func() -> bool;
  deliver: func() -> bool;
  move-to: func(x: s32, y: s32) -> bool;
  load: func(item: item-kind, amount: s32) -> s32;
  unload: func(item: item-kind, amount: s32) -> s32;
  cargo-count: func(item: item-kind) -> s32;
  idle: func() -> bool;
}

world drill-behavior {
  import common-api;
  import net-api;
  import drill-api;

  export tick: func();
}

world router-behavior {
  import common-api;
  import net-api;
  import router-api;

  export tick: func();
}

world assembler-behavior {
  import common-api;
  import net-api;
  import assembler-api;

  export tick: func();
}

world turret-behavior {
  import common-api;
  import net-api;
  import turret-api;

  export tick: func();
}

world drone-port-behavior {
  import common-api;
  import net-api;
  import drone-port-api;

  export tick: func();
}

world carrier-drone-behavior {
  import common-api;
  import net-api;
  import drone-api;

  export tick: func();
}
