package xac:mvp;

interface types {
  record vec2 {
    x: s32,
    y: s32,
  }

  type entity-id = string;
  type item-kind = string;
  type enemy-kind = string;

  record item {
    id: entity-id,
    kind: item-kind,
    amount: s32,
  }

  record enemy-info {
    id: entity-id,
    kind: enemy-kind,
    pos: vec2,
    hp: s32,
    distance: f32,
  }

  record delivery-job {
    id: entity-id,
    item-kind: item-kind,
    amount: s32,
    pickup: entity-id,
    dropoff: entity-id,
  }

  variant value {
    none,
    bool(bool),
    s32(s32),
    s64(s64),
    f32(float32),
    f64(float64),
    string(string),
    id(entity-id),
    pos(vec2),
  }
}

interface common-api {
  use types.{value};

  log: func(message: string);
  net-store-get: func(key: string) -> value;
  net-store-set: func(key: string, value: value);
  net-store-delete: func(key: string);
  stock-count: func(item-kind: string) -> s32;
  stock-capacity: func(item-kind: string) -> s32;
  has-space: func(item-kind: string, amount: s32) -> bool;
  fuel-remaining: func() -> u64;
}

interface drill-api {
  output-blocked: func() -> bool;
  mine: func() -> bool;
  output: func(item-kind: string) -> bool;
  ore-kind: func() -> string;
}

interface router-api {
  use types.{item};

  push: func(dir: string, item: item) -> bool;
  push-item-dir: func(item-kind: string, dir: string) -> bool;
  push-any: func(item: item) -> bool;
  output-available: func(dir: string) -> bool;
  output-item-available: func(item-kind: string, dir: string) -> bool;
}

interface turret-api {
  use types.{enemy-info};

  scan-enemies: func() -> list<enemy-info>;
  attack: func(enemy-id: string) -> bool;
  attack-nearest: func() -> bool;
  attack-best: func(policy: string) -> bool;
  ammo-count: func() -> s32;
}

interface assembler-api {
  set-recipe: func(recipe-id: string) -> bool;
  current-recipe: func() -> string;
  can-produce: func() -> bool;
  produce: func() -> bool;
  input-count: func(item-kind: string) -> s32;
  output-count: func(item-kind: string) -> s32;
}

interface drone-api {
  battery-ratio: func() -> f32;
  battery-percent: func() -> s32;
  logic-fuel-remaining: func() -> u64;
  has-job: func() -> bool;
  has-pending-job: func() -> bool;
  move-to: func(x: s32, y: s32) -> bool;
  load: func(item-kind: string, amount: s32) -> s32;
  unload: func(item-kind: string, amount: s32) -> s32;
  cargo-count: func(item-kind: string) -> s32;
  return-to-port: func() -> bool;
  claim-delivery-job: func() -> bool;
  deliver: func() -> bool;
  idle: func() -> bool;
}

interface drone-port-api {
  stock-count: func(item-kind: string) -> s32;
  charge-docked-drones: func() -> bool;
  docked-drone-count: func() -> s32;
  pending-job-count: func() -> s32;
  create-delivery-job: func(item-kind: string, amount: s32, dropoff-tag: string) -> bool;
  dispatch-idle-drones: func() -> bool;
  dispatch: func() -> bool;
}

world drill-behavior {
  import common-api;
  import drill-api;

  export init: func();
  export tick: func();
}

world router-behavior {
  import common-api;
  import router-api;
  use types.{item};

  export init: func();
  export on-item: func(item: item);
}

world turret-behavior {
  import common-api;
  import turret-api;

  export init: func();
  export tick: func();
}

world assembler-behavior {
  import common-api;
  import assembler-api;

  export init: func();
  export tick: func();
}

world drone-port-behavior {
  import common-api;
  import drone-port-api;

  export init: func();
  export tick: func();
}

world carrier-drone-behavior {
  import common-api;
  import drone-api;

  export init: func();
  export tick: func();
}
