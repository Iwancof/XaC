{
  "name": "xac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:e2e": "vite --host 127.0.0.1 --port ${XAC_E2E_PORT:-5174} --strictPort --mode test",
    "build": "npm run build:ui && tauri build",
    "build:ui": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:rust": "scripts/cargo-fast.sh test --workspace",
    "test:rust:fast": "scripts/cargo-fast.sh test-fast",
    "clippy:rust": "scripts/cargo-fast.sh clippy --workspace --all-targets -- -D warnings",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:grep": "playwright test --workers=1 -g",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:smoke": "playwright test --workers=1 -g @smoke"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.53.0",
    "pixi.js": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
